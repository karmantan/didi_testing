# bundle_settings.env
#
# Every value a person running this bundle on Posit Workbench might reasonably want to
# change lives here, in plain KEY=value form. Scripts source this file; nothing in
# scripts/ hard-codes these values. Edit this file, then re-run the affected stage(s)
# (see docs/SETUP_GUIDE.md "How to change things" for which stage to re-run after each
# key).
#
# Lines are read with a simple `KEY=value` parser (scripts/_lib.sh's `load_settings`).
# Do not add spaces around `=`. Comments (lines starting with #) and blank lines are
# ignored. Values are NOT quoted.

# Colon-separated list of Python interpreters to try, in order. The first one found that
# reports a 3.9.x version is used; scripts refuse to fall back to any other major version
# (see requirements.txt for why: the polars==0.20.16 / numpy==1.25.0 wheels used here are
# tied to the CPython 3.9 ABI). Posit Workbench conventionally installs interpreters under
# /opt/python/<version>/bin/python3 and lets you pick one when you launch the session --
# pick Python 3.9.1 there; this list is a safety net that finds it even if the session's
# default `python3` on PATH points somewhere else.
PYTHON_CANDIDATES=/opt/python/3.9.1/bin/python3:/opt/python/3.9.*/bin/python3:/opt/homebrew/bin/python3.9:python3.9:python3

# Where generated synthetic raw data and pipeline run outputs are written. Deliberately
# OUTSIDE the bundle folder (default: one level up, next to it) so the bundle itself stays
# small enough to zip and re-upload without dragging multi-GB generated data along with it.
# Resolved to an absolute path at runtime relative to the bundle's own location -- never
# edit this to an absolute path yourself.
DATA_ROOT=../didi_data

# The scale ladder this bundle is designed to walk up, as fractions of the real 20% sample
# (211,593,776 raw rows at fraction 1.0). Space-separated. `scripts/run_stage.sh all
# <scale>` accepts any single value from this ladder (or any other fraction you type
# directly -- the ladder is a suggested path, not an enforced list).
SCALE_LADDER=0.001 0.01 0.1 1.0

# Deterministic seed used by generate_raw.py and by the real USER_CONFIG's own seed (see
# export_20260911/20pct/260909/resolved_config.json: "seed": 42). Keeping the same seed
# across scales makes a smaller run's shards a true subset-in-distribution of a larger
# run's, not an independent draw.
SEED=42

# Number of raw Parquet shards to write, at every scale. The real 20% data used exactly 22
# shards (export_20260911/20pct/260909/run_manifest.json "raw_files": 22 entries); keeping
# the shard count fixed across scales (rather than scaling it) means smaller scales just
# get smaller shards, matching how a smaller extract of the same source data would look.
SHARDS=22

# Bootstrap replicate counts. SMOKE is used by scripts/make_config.py by default (matches
# what Gate 2 used for its 1% run: 200->20, see export_20260911/GATE2_REPORT.md "six-key
# diff"). PRODUCTION is used only when make_config.py is called with --production, and
# matches the real run's actual value (outcome_bootstrap_replicates,
# absolute_effect_bootstrap_replicates, and mediation_bootstrap_replicates are all 200 in
# export_20260911/20pct/260909/resolved_config.json).
BOOTSTRAP_REPLICATES_SMOKE=20
BOOTSTRAP_REPLICATES_PRODUCTION=200

# Mediation bootstrap worker count. 0 means "let make_config.py choose", based on
# results/machine.json's available_ram_gib and a logged per-worker mediation panel size
# (see docs/SETUP_GUIDE.md "How to change things"). Set a specific integer here to override
# that logic once you know the actual per-worker memory footprint from a completed run.
MEDIATION_WORKERS=0

# scripts/memory_gate.py refuses to GO unless projected peak memory <= this fraction of
# results/machine.json's available_ram_gib. 0.8 leaves a 20% safety margin for whatever the
# projection under- or over-estimates.
MEMORY_GATE_FRACTION=0.8
